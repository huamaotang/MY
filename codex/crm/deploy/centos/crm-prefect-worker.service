[Unit]
Description=CRM Prefect Process Worker
After=network-online.target crm-prefect-server.service
Wants=network-online.target crm-prefect-server.service

[Service]
Type=simple
User=crm
Group=crm
WorkingDirectory=/opt/crm/fund_spider
EnvironmentFile=-/etc/crm/fund-spider.env
Environment=PREFECT_HOME=/opt/crm/fund_spider/.prefect
Environment=CRM_FUND_SPIDER_DIR=/opt/crm/fund_spider
Environment=PREFECT_WORK_POOL=crm-process-pool
Environment=PREFECT_WORKER_LIMIT=1
ExecStart=/opt/crm/fund_spider/bin/run_prefect_worker.sh
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
