[Unit]
Description=CRM Prefect Server and UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crm
Group=crm
WorkingDirectory=/opt/crm/fund_spider
EnvironmentFile=-/etc/crm/fund-spider.env
Environment=PREFECT_HOME=/opt/crm/fund_spider/.prefect
Environment=PREFECT_SERVER_HOST=127.0.0.1
Environment=PREFECT_SERVER_PORT=4200
Environment=PREFECT_UI_API_URL=http://127.0.0.1:4200/api
ExecStart=/opt/crm/fund_spider/bin/run_prefect_server.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
