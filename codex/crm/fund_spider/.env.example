DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=fund

# Request pacing. Keep this conservative unless you have permission to increase it.
REQUEST_MIN_DELAY_SECONDS=1.5
REQUEST_MAX_DELAY_SECONDS=4.0
REQUEST_TIMEOUT_SECONDS=10
REQUEST_MAX_RETRIES=3

# SQL write logging. LOG_SQL_PARAMS can be very verbose in batch runs.
LOG_SQL=0
LOG_SQL_PARAMS=0
LOG_SQL_MAX_PARAMS=3

# Pagination.
PAGE_SIZE=200
START_PAGE=1
# Empty means crawl all pages reported by EastMoney.
MAX_PAGES=

# Historical NAV crawler. Defaults match https://fundf10.eastmoney.com/jjjz_519674.html
NAV_FUND_CODE=519674
NAV_PAGE_SIZE=20
NAV_START_PAGE=1
# Empty means crawl all historical NAV pages reported by EastMoney.
NAV_MAX_PAGES=
NAV_START_DATE=
NAV_END_DATE=

# Batch crawler from cfg_fund.
# Empty FUND_LIMIT means all existing fund codes; use a small number for testing.
FUND_CODE=
FUND_LIMIT=
FUND_OFFSET=0
CRAWL_PROFILE=1
CRAWL_NAV=1

# Feature data crawler. Empty FEATURE_FUND_CODE means read fund codes from cfg_fund.
FEATURE_FUND_CODE=

# Rating crawler. Empty RATING_FUND_CODE means read fund codes from cfg_fund.
RATING_FUND_CODE=
RATING_PAGE_SIZE=50

# Holding crawler. Empty HOLDING_FUND_CODE means read fund codes from cfg_fund.
HOLDING_FUND_CODE=
HOLDING_TOP_LINE=10
HOLDING_YEAR=
HOLDING_MONTH=

# Python daily scheduler, similar to a lightweight local xxl-job executor.
SCHEDULE_TIME=20:00
SCHEDULER_WEB_HOST=127.0.0.1
SCHEDULER_WEB_PORT=8088
SCHEDULER_RUN_ON_START=0
SCHEDULER_ONCE=0
SCHEDULER_DRY_RUN=0
DAILY_CRAWL_FUND_LIST=1
DAILY_CRAWL_PROFILE_NAV=1
DAILY_CRAWL_PROFILE=1
DAILY_CRAWL_NAV=1
DAILY_CRAWL_FEATURE=1
DAILY_CRAWL_RATING=1
DAILY_CRAWL_HOLDINGS=1
# Empty means daily NAV starts from today minus DAILY_NAV_LOOKBACK_DAYS.
DAILY_NAV_START_DATE=
DAILY_NAV_END_DATE=
DAILY_NAV_LOOKBACK_DAYS=10
# Empty means crawl all pages in the date window; if no date window is set, daily job defaults to 1 NAV page.
DAILY_NAV_MAX_PAGES=
# Daily cursor. Same-day reruns resume after the last successful fund code.
DAILY_USE_CURSOR=1
DAILY_CURSOR_DATE=
DAILY_CURSOR_JOB_NAME=daily_update
