DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=fund

# Request pacing. Keep this conservative unless you have permission to increase it.
REQUEST_MIN_DELAY_SECONDS=1.5
REQUEST_MAX_DELAY_SECONDS=4.0
REQUEST_TIMEOUT_SECONDS=10
REQUEST_MAX_RETRIES=3

# Yangjibao news API. Capture fresh values from the official app; do not commit real credentials.
YJB_AUTHORIZATION=
YJB_REQUEST_SIGN=
YJB_REQUEST_TIME=
YJB_USER_AGENT=YJB/2.0.6 (com.xiaoduotou.yjb; build:911; iOS) Alamofire/5.11.2
YJB_COOKIE=
YJB_NEWS_SCORE=2
SINA_NEWS_PAGE_SIZE=20
SINA_NEWS_MAX_PAGES=1
SINA_NEWS_TAG=0

# SQL write logging. LOG_SQL_PARAMS can be very verbose in batch runs.
LOG_SQL=0
LOG_SQL_PARAMS=0
LOG_SQL_MAX_PARAMS=3

# Pagination.
PAGE_SIZE=50
START_PAGE=1
# Empty means crawl all pages reported by EastMoney.
MAX_PAGES=

# Historical NAV crawler. Empty NAV_FUND_CODE means use the fund_detail batch.
NAV_FUND_CODE=
NAV_PAGE_SIZE=20
NAV_START_PAGE=1
# Concurrent historical NAV page requests. Set to 1 for sequential crawling.
NAV_PAGE_WORKERS=4
# Commit multiple fetched pages in one database transaction.
NAV_WRITE_BATCH_SIZE=200
# Empty means crawl all historical NAV pages reported by EastMoney.
NAV_MAX_PAGES=
NAV_START_DATE=
NAV_END_DATE=

# Batch crawler from fund_detail.
# Empty FUND_LIMIT means all existing fund codes; use a small number for testing.
FUND_CODE=
FUND_LIMIT=
FUND_OFFSET=0
BASIC_REFRESH_LIST=

# Feature data crawler. Empty FEATURE_FUND_CODE means read fund codes from fund_detail.
FEATURE_FUND_CODE=

# Rating crawler. Empty RATING_FUND_CODE means read fund codes from fund_detail.
RATING_FUND_CODE=
RATING_PAGE_SIZE=50
RATING_MAX_PAGES=

# Holding crawler. Empty HOLDING_FUND_CODE means read fund codes from fund_detail.
HOLDING_FUND_CODE=
HOLDING_TOP_LINE=10
HOLDING_YEAR=
HOLDING_MONTH=

# Prefect self-hosted orchestration. Schedules are stored in prefect.yaml and
# are editable from the Prefect UI after deployment.
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_SERVER_HOST=127.0.0.1
PREFECT_SERVER_PORT=4200
PREFECT_UI_API_URL=http://127.0.0.1:4200/api
PREFECT_SERVER_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect:prefect@127.0.0.1:5433/prefect
PREFECT_WORK_POOL=crm-process-pool
PREFECT_WORKER_NAME=crm-worker
# Keep one business flow running at a time.
PREFECT_WORKER_LIMIT=1
