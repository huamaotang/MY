{
  "name": "md2html-cli",
  "version": "1.0.0",
  "description": "A small TypeScript CLI that converts Markdown files to styled HTML.",
  "type": "module",
  "bin": {
    "md2html": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "markdown",
    "html",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
